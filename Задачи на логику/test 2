A = int (input("Введите первое число:"))
B = int (input("Введите второе число:"))
s = 0
for i in range (A, B + 1):
    if i  % 2 == 0:
        s = s + i
    else:
        s = s - i
print("Сумма:", s)
#  Вводится два числа и перебирает все числа между ними включительно.
#  Если число чётное, оно прибавляется к переменной s, а если нечётное — вычитается.
#  В конце программа выводит разность между суммой чётных и нечётных чисел
