n = 0
for a in "XYZ":
    for b in "XYZ":
        for c in "XYZ":
            for d in "XYZ":
                for e in "XYZ":
                    n = n + 1
                    if n == 179:
                        print(a + b + c + d + e)
# Я использую пять циклов, чтобы перебрать все возможные последовательности из пяти букв X, Y и Z.
#  Переменная n считает количество последовательностей.
#  Когда счётчик доходит до 179, программа выводит нужное.
