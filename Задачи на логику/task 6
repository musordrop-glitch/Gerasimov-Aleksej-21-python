n = int(input("Введите положительное число"))
s = 0

for i in range(1, n + 1):
    if i % 2 == 1:
        if i % 3 > 0:
            if i % 5 > 0:
                s = s + 1

print("Кол-во целых чисел:", s)
# Сначала я ввожу число n и создаю переменную s, равную нулю. Затем перебираю все числа от 1 до n.
# Проверяю, чтобы число было нечётным и не делилось на 3 и 5 без остатка. Если число подходит, увеличиваю s на 1.
# В конце программа выводит количество таких чисел.
